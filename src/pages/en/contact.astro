---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact | Guo Lab">
  <header class="space-y-2">
    <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
    <p class="max-w-2xl text-sm leading-6 text-slate-700">
      Contact details, collaboration, and recruiting information. We can add a map and a contact form later if needed.
    </p>
  </header>

  <section class="mt-8 grid gap-4 sm:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 p-5">
      <h2 class="font-semibold">Email</h2>
      <p class="mt-1 text-sm text-slate-600">your-email@university.edu</p>
    </div>
    <div class="rounded-2xl border border-slate-200 p-5">
      <h2 class="font-semibold">Address</h2>
      <p class="mt-1 text-sm text-slate-600">University · Building · Room</p>
    </div>
  </section>
</Layout>

