---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const news = (await getCollection('news', (e) => e.data.lang === 'en'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="News | Guo Lab">
  <header class="space-y-2">
    <h1 class="text-3xl font-semibold tracking-tight">News</h1>
    <p class="max-w-2xl text-sm leading-6 text-slate-700">
      News posts are powered by a content collection in `src/content/news/`. Later, you can publish updates via the CMS admin.
    </p>
  </header>

  <section class="mt-8 space-y-3">
    {news.map((n) => (
      <a class="block rounded-2xl border border-slate-200 p-5 hover:border-slate-300" href={`/en/news/${n.data.key}`}>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h2 class="font-semibold">{n.data.title}</h2>
          <p class="text-xs text-slate-600">{n.data.date.toISOString().slice(0, 10)}</p>
        </div>
        {n.data.summary ? <p class="mt-2 text-sm text-slate-700">{n.data.summary}</p> : null}
      </a>
    ))}
  </section>
</Layout>

