---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const zhNews = await getCollection('news', (e) => e.data.lang === 'zh');
  return zhNews.map((n) => ({ params: { slug: n.data.key } }));
}

const { slug } = Astro.params;
const entry = (await getCollection('news', (e) => e.data.lang === 'zh')).find((e) => e.data.key === slug);
if (!entry) {
  return Astro.redirect('/news');
}

const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | 新闻 | Guo Lab`}>
  <article class="prose prose-slate max-w-none">
    <p class="not-prose text-sm text-slate-600">
      <a class="hover:text-slate-900" href="/news">← 返回新闻</a>
    </p>
    <h1 class="not-prose mt-6 text-3xl font-semibold tracking-tight">{entry.data.title}</h1>
    <p class="not-prose mt-2 text-sm text-slate-600">{entry.data.date.toISOString().slice(0, 10)}</p>
    {entry.data.summary ? <p class="not-prose mt-4 text-slate-700">{entry.data.summary}</p> : null}
    <div class="mt-8">
      <Content />
    </div>
  </article>
</Layout>

