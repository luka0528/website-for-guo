---
import Layout from '../layouts/Layout.astro';
---

<Layout title="联系 | Guo Lab">
  <header class="space-y-2">
    <h1 class="text-3xl font-semibold tracking-tight">联系</h1>
    <p class="max-w-2xl text-sm leading-6 text-slate-700">
      这里将展示地址、邮箱、合作方式与招生信息。后续可以加入地图与联系表单（可选）。
    </p>
  </header>

  <section class="mt-8 grid gap-4 sm:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 p-5">
      <h2 class="font-semibold">邮箱</h2>
      <p class="mt-1 text-sm text-slate-600">your-email@university.edu</p>
    </div>
    <div class="rounded-2xl border border-slate-200 p-5">
      <h2 class="font-semibold">地址</h2>
      <p class="mt-1 text-sm text-slate-600">某某大学 · 某某楼 · 某某室</p>
    </div>
  </section>
</Layout>

