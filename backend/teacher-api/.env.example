# Copy to .env on the server (never commit .env)

DATABASE_URL="mysql://app_user:PASSWORD@rm-xxxx.mysql.rds.aliyuncs.com:3306/teacher_site"
PORT=3000

# Required for JWT access tokens (use a long random string in production)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m

REFRESH_TOKEN_DAYS=7

# Astro dev: http://localhost:4321 — multiple origins: http://a:4321,http://b:4321
CORS_ORIGIN=http://localhost:4321

# Set true behind HTTPS; local dev can omit or false
# COOKIE_SECURE=false

# --- OSS signed download ---
# Region example: oss-cn-hangzhou / oss-cn-beijing / oss-cn-shanghai
OSS_REGION=
OSS_BUCKET=
# Use a RAM sub-account with read-only permission on the bucket, not the root AK
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Signed URL lifetime, seconds (30–3600; default 180)
DOWNLOAD_URL_TTL=180
